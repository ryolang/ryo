struct Person:
	name: str
	age: int

fn make_person(i: int) -> Person:
	return Person{name="user" + int_to_str(i), age=20 + i % 50}

fn birthday(p: Person) -> Person:
	return Person{name=p.name + "", age=p.age + 1}

fn score(p: Person) -> int:
	return p.name.len() + p.age

fn main():
	mut total = 0
	for i in range(0, 500000):
		p = make_person(i)
		q = birthday(p)
		total += score(p) + score(q)
	assert(total == 54777780, "struct_records_reuse checksum")
	print("assert passed, struct_records_reuse is correct\n")
