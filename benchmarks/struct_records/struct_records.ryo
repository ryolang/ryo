struct Person:
	name: str
	age: int

fn make_person(i: int) -> Person:
	return Person{name="user" + int_to_str(i), age=20 + i % 50}

fn birthday(move p: Person) -> Person:
	mut q = p
	q.age += 1
	return q

fn score(p: Person) -> int:
	return p.name.len() + p.age

fn main():
	mut total = 0
	for i in range(0, 500000):
		p = make_person(i)
		q = birthday(p)
		total += score(q)
	assert(total == 27638890, "struct_records checksum")
	print("assert passed, struct_records is correct\n")
