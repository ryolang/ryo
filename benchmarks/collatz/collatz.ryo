fn collatz_steps(start: int) -> int:
	mut n = start
	mut steps = 0
	while n != 1:
		if n % 2 == 0:
			n = n / 2
		else:
			n = 3 * n + 1
		steps += 1
	return steps

fn main():
	mut total = 0
	for i in range(1, 1000001):
		total += collatz_steps(i)
	assert(total == 131434424, "collatz checksum")
	print("assert passed, collatz is correct\n")
