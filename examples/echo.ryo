# echo.ryo - Read from stdin and print each line
#
# Usage:
#     printf 'Hello\nWorld\n' | cargo run -- run examples/echo.ryo
#
# Stops on an empty line: io_read_line returns "" both for an empty
# line and at end of input (EOF has no distinct signal yet), so a
# blank line mid-stream terminates the loop too.
#
fn main():
	while true:
		line = io_read_line()
		if line == "":
			break
		print(line + "\n")
