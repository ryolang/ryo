# bytes/bytesview (M8.4.2) — owned byte buffers and read-only views.
# Interims: b[i] yields int (0-255) until M17.1; to_str() panics on
# invalid UTF-8 until M13; hex int literals (0xFF) land at M8.7.
fn main():
	raw = b"\x01\x02\x03"
	header = raw[0:2]             # bytesview — projection, no copy
	print(int_to_str(header[0]))  # 1 — b[i] yields int (interim)

	mut buf = b"\x00"
	bytes_push(&buf, 255)         # hex literals (0xFF) are not implemented yet
	buf = buf + raw
	print(buf)                    # b"\0\xff\x01\x02\x03"

	text = "héllo".to_bytes()    # owned bytes from a str
	back = text.to_str()          # panics on invalid UTF-8 (interim)
	print(back)
