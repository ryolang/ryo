
fn main():
	iee754_infinite = 1.0/(2.0-2.0)
	# No `inf` literal exists, so assert via IEEE identities:
	# 2*x == x holds only for 0 and ±inf (NaN fails since NaN != NaN),
	# and x > 0.0 rules out 0 and -inf.
	assert(iee754_infinite > 0.0 and iee754_infinite * 2.0 == iee754_infinite, "expected +inf")
	print(float_to_str(iee754_infinite))
