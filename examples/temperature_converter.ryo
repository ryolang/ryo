# temperature_converter.ryo
# Temperature conversion example demonstrating enums, structs, and pattern matching

enum TempScale:
	Celsius
	Fahrenheit
	Kelvin

struct Temperature:
	value: float
	scale: TempScale

fn to_celsius(temp: Temperature) -> Temperature:
	match temp.scale:
		TempScale.Celsius:
			return temp
		TempScale.Fahrenheit:
			return Temperature{value=(temp.value - 32.0) * 5.0 / 9.0, scale=TempScale.Celsius}
		TempScale.Kelvin:
			return Temperature{value=temp.value - 273.15, scale=TempScale.Celsius}

fn to_fahrenheit(temp: Temperature) -> Temperature:
	celsius = to_celsius(temp)
	return Temperature{value=celsius.value * 9.0 / 5.0 + 32.0, scale=TempScale.Fahrenheit}

fn to_kelvin(temp: Temperature) -> Temperature:
	celsius = to_celsius(temp)
	return Temperature{value=celsius.value + 273.15, scale=TempScale.Kelvin}

fn main():
	# Create a temperature in Fahrenheit
	temp_f = Temperature{value=98.6, scale=TempScale.Fahrenheit}

	# Convert to all scales
	temp_c = to_celsius(temp_f)
	temp_k = to_kelvin(temp_f)

	print("Body temperature:\n")
	print("  Celsius: ")
	print(temp_c.value)
	print("°C\n")
	print("  Fahrenheit: ")
	print(temp_f.value)
	print("°F\n")
	print("  Kelvin: ")
	print(temp_k.value)
	print("K\n")
